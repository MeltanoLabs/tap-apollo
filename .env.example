# Apollo Configuration
# Copy this file to .env and fill in your actual values

# Required: Apollo API key (a master key, or one with access to each selected stream's endpoint)
TAP_APOLLO_API_KEY=your_api_key_here

# Optional: Earliest update time to extract for incremental streams (ISO format)
TAP_APOLLO_START_DATE=2024-01-01T00:00:00Z
